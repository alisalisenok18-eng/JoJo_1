@model List<JoJo.Models.Character>

@{
    ViewData["Title"] = "Персонажи";
}

<h1 class="my-4 text-center">Персонажи «Невероятных приключений ДжоДжо»</h1>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    @foreach (var character in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="@character.UrlPhoto" class="card-img-top" alt="@character.Name"
                     style="object-fit: cover; height: 400px;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@character.Name</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@character.Part</h6>
                    <p class="card-text mb-1"><strong>Стенд:</strong> @character.Stand</p>
                    <p class="card-text">@character.Description</p>
                    <a asp-controller="Character" asp-action="Details" asp-route-id="@character.Id"
                       class="btn btn-primary mt-auto">Подробнее</a>
                </div>
            </div>
        </div>
    }
</div>