@model List<JoJo.Models.Character>

@{
    ViewData["Title"] = "Список персонажей";
}

<h1>Список персонажей</h1>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Имя</th>
            <th>Часть</th>
            <th>Стенд</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Name</td>
                <td>@c.Part</td>
                <td>@c.Stand</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary"
                       asp-controller="Character" asp-action="Details" asp-route-id="@c.Id">Подробнее</a>
                </td>
            </tr>
        }
    </tbody>
</table>