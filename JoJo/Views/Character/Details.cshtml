@model JoJo.Models.Character

@{
    ViewData["Title"] = Model.Name;
}

<div class="row">
    <div class="col-md-4">
        <img src="@Model.UrlPhoto" class="img-fluid rounded shadow" alt="@Model.Name" />
    </div>
    <div class="col-md-8">
        <h1>@Model.Name</h1>
        <p class="text-muted">@Model.Part</p>
        <p><strong>Стенд:</strong> @Model.Stand</p>
        <p>@Model.Description</p>
        <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">← Назад к персонажам</a>
    </div>
</div>